{"agentId": "5", "threadId": "baozun-B4-8f709e", "nodeName": "SqlExecuteNode", "textType": "SQL", "text": "SELECT SUM(`available_qty`) \nFROM `wms_inventory_snapshot` AS `i`\nJOIN `wms_warehouse` AS `w` ON `i`.`warehouse_id` = `w`.`id`\nJOIN `prd_sku` AS `s` ON `i`.`sku_id` = `s`.`id`\nJOIN `prd_spu` AS `p` ON `s`.`spu_id` = `p`.`id`\nJOIN `prd_category` AS `c3` ON `p`.`category_id` = `c3`.`id`\nJOIN `prd_category` AS `c2` ON `c3`.`parent_id` = `c2`.`id`\nJOIN `prd_category` AS `c1` ON `c2`.`parent_id` = `c1`.`id`\nWHERE `i`.`snapshot_date` >= '2026-10-15' AND `i`.`snapshot_date` < '2026-10-16'\n  AND `w`.`name` = '华东区域仓'\n  AND `c1`.`name` = '数码家电';\n", "error": false, "complete": false, "_t": 43.33}
