{"agentId": "5", "threadId": "baozun-B5-cddb3b", "nodeName": "SqlExecuteNode", "textType": "SQL", "text": "select \n    `b`.`name` as `brand_name`,\n    sum(case \n        when `o`.`is_presale` = 1 then `p`.`balance_amount` + `p`.`deposit_amount`\n        else `o`.`pay_amount`\n    end) as `gmv`\nfrom `trd_order` `o`\nleft join `trd_presale_order` `p` on `o`.`id` = `p`.`order_id` and `p`.`is_deleted` = 0\ninner join `dim_shop` `s` on `o`.`shop_id` = `s`.`id`\ninner join `prd_brand` `b` on `s`.`brand_id` = `b`.`id`\nwhere `o`.`is_deleted` = 0\n  and (\n    (`o`.`is_presale` = 0 and `o`.`paid_at` >= '2025-10-31 00:00:00' and `o`.`paid_at` < '2025-11-12 00:00:00')\n    or \n    (`o`.`is_presale` = 1 and `p`.`balance_paid_at` >= '2025-10-31 00:00:00' and `p`.`balance_paid_at` < '2025-11-12 00:00:00')\n  )\ngroup by `b`.`name`;\n", "error": false, "complete": false, "_t": 34.59}
