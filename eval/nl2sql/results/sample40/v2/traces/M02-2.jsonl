{"agentId": "5", "threadId": "v2-M02-2-1460c9", "nodeName": "SqlExecuteNode", "textType": "SQL", "text": "select `sku_id` from `trd_daily_sku_sales` tds join `prd_sku` ps on tds.`sku_id` = ps.`id` join `prd_spu` psp on ps.`spu_id` = psp.`id` join `prd_category` pc on psp.`category_id` = pc.`id` where pc.`name` = '服饰鞋包' and tds.`stat_date` >= '2026-04-01' and tds.`stat_date` < '2026-05-01' group by `sku_id` order by sum(tds.`sales_amount`) desc limit 3;\n", "error": false, "complete": false, "_t": 38.29}
