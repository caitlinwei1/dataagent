{"agentId": "5", "threadId": "mix-S13-4-58cfad", "nodeName": "SqlExecuteNode", "textType": "SQL", "text": "SELECT \n  SUM(CASE WHEN `refund_type` = 'REFUND_ONLY' AND `refund_status` = 'SUCCESS' THEN `refund_amount` ELSE 0 END) AS `refund_only_amount`,\n  SUM(CASE WHEN `refund_type` = 'RETURN_REFUND' AND `refund_status` = 'SUCCESS' THEN `refund_amount` ELSE 0 END) AS `return_refund_amount`\nFROM `trd_refund`\nWHERE (`refund_type` = 'REFUND_ONLY' OR `refund_type` = 'RETURN_REFUND')\n  AND `refund_status` = 'SUCCESS'\n  AND `refunded_at` >= '2025-02-01' AND `refunded_at` < '2025-03-01';\n", "error": false, "complete": false, "_t": 33.0}
