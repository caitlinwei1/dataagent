{"agentId": "7", "threadId": "turbo-M12-1-732725", "nodeName": "SqlExecuteNode", "textType": "SQL", "text": "SELECT\n  DATE_FORMAT(`o`.`paid_at`, '%Y-%m') AS `month`,\n  SUM(`oi`.`pay_share`) AS `sales_amount`\nFROM `trd_order` `o`\nJOIN `trd_order_item` `oi` ON `o`.`id` = `oi`.`order_id`\nJOIN `prd_category` `c3` ON `oi`.`category_id` = `c3`.`id`\nJOIN `prd_category` `c2` ON `c3`.`parent_id` = `c2`.`id`\nJOIN `prd_category` `c1` ON `c2`.`parent_id` = `c1`.`id`\nWHERE `o`.`paid_at` >= '2025-01-01'\n  AND `o`.`paid_at` < '2026-01-01'\n  AND `o`.`order_status` NOT IN ('CANCELLED', 'CLOSED')\n  AND `c1`.`name` = '服饰鞋包'\nGROUP BY `month`\nORDER BY `month`;\n", "error": false, "complete": false, "_t": 13.46}
