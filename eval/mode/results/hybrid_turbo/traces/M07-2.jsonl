{"agentId": "7", "threadId": "turbo-M07-2-b7a497", "nodeName": "SqlExecuteNode", "textType": "SQL", "text": "SELECT\n  `year_month`,\n  SUM(`gmv`) AS `gmv`\nFROM (\n  SELECT\n    DATE_FORMAT(`o`.`paid_at`, '%Y-%m') AS `year_month`,\n    SUM(`o`.`total_amount` + `o`.`freight_amount`) AS `gmv`\n  FROM `trd_order` `o`\n  WHERE `o`.`is_deleted` = 0\n    AND `o`.`paid_at` IS NOT NULL\n    AND (`o`.`paid_at` >= '2026-03-01' AND `o`.`paid_at` < '2026-04-01'\n         OR `o`.`paid_at` >= '2025-03-01' AND `o`.`paid_at` < '2025-04-01')\n  GROUP BY DATE_FORMAT(`o`.`paid_at`, '%Y-%m')\n) `t`\nGROUP BY `year_month`\nORDER BY `year_month`;\n", "error": false, "complete": false, "_t": 12.92}
