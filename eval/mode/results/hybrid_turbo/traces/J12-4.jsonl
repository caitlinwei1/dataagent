{"agentId": "7", "threadId": "turbo-J12-4-2d5697", "nodeName": "SqlExecuteNode", "textType": "SQL", "text": "SELECT\n  `r`.`big_region`,\n  SUM(`o`.`pay_amount`) / COUNT(`o`.`id`) AS `atv`\nFROM `trd_order` `o`\nJOIN `dim_shop` `s` ON `o`.`shop_id` = `s`.`id`\nJOIN `dim_region` `r` ON `s`.`region_id` = `r`.`id`\nWHERE `o`.`paid_at` >= '2026-02-01'\n  AND `o`.`paid_at` < '2026-03-01'\n  AND `r`.`big_region` IN ('西南', '东北')\nGROUP BY `r`.`big_region`;\n", "error": false, "complete": false, "_t": 12.56}
