{"agentId": "7", "threadId": "turbo-J15-4-faa2fb", "nodeName": "SqlExecuteNode", "textType": "SQL", "text": "SELECT\n  DATE(o.`paid_at`) AS `stat_date`,\n  SUM(o.`pay_amount`) AS `daily_paid_amount`\nFROM `trd_order` o\nJOIN `dim_shop` s ON o.`shop_id` = s.`id`\nJOIN `dim_region` r ON s.`region_id` = r.`id`\nWHERE o.`paid_at` >= '2026-02-01'\n  AND o.`paid_at` < '2026-03-01'\n  AND r.`big_region` = '华中'\nGROUP BY DATE(o.`paid_at`)\n", "error": false, "complete": false, "_t": 12.65}
