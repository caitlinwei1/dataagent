{"agentId": "7", "threadId": "turbo-J05-2-b6ecaf", "nodeName": "SqlExecuteNode", "textType": "SQL", "text": "SELECT `carrier`.`name`, AVG(TIMESTAMPDIFF(HOUR, `order`.`paid_at`, `shipment`.`delivered_at`)) AS `avg_fulfillment_hours`\nFROM `tms_shipment` AS `shipment`\nJOIN `oms_fulfillment_order` AS `fulfillment` ON `shipment`.`fulfillment_id` = `fulfillment`.`id`\nJOIN `trd_order` AS `order` ON `fulfillment`.`order_id` = `order`.`id`\nJOIN `tms_carrier` AS `carrier` ON `shipment`.`carrier_id` = `carrier`.`id`\nWHERE `order`.`paid_at` >= '2026-03-01' AND `order`.`paid_at` < '2026-04-01'\nAND `shipment`.`delivered_at` IS NOT NULL\nAND `order`.`paid_at` IS NOT NULL\nGROUP BY `carrier`.`id`, `carrier`.`name`\nORDER BY `avg_fulfillment_hours` DESC\nLIMIT 3;\n", "error": false, "complete": false, "_t": 13.45}
