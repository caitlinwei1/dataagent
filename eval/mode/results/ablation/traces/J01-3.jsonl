{"agentId": "5", "threadId": "mix-nocases-J01-3-adb3ba", "nodeName": "SqlExecuteNode", "textType": "SQL", "text": "SELECT s.`name`\nFROM `trd_order` o\nJOIN `dim_shop` s ON o.`shop_id` = s.`id`\nJOIN `dim_region` r ON s.`region_id` = r.`id`\nWHERE o.`paid_at` >= '2026-03-01' AND o.`paid_at` < '2026-04-01'\n  AND r.`big_region` = '华南'\n  AND o.`paid_at` IS NOT NULL\nGROUP BY s.`name`\nORDER BY SUM(o.`pay_amount`) DESC\nLIMIT 2;\n", "error": false, "complete": false, "_t": 33.83}
